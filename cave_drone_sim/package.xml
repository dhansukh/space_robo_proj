<?xml version="1.0"?>
<?xml-model href="http://download.ros.org/schema/package_format3.xsd" schematypens="http://www.w3.org/2001/XMLSchema"?>
<package format="3">
  <name>cave_drone_sim</name>
  <version>0.1.0</version>
  <description>
    Top-level integration package for the Cave Drone Exploration simulation.
    Provides master launch files that tie together cave_generator, drone_bringup,
    slam_pipeline, and exploration_planner into a complete end-to-end demo.
  </description>
  <maintainer email="thesis@example.com">Thesis Author</maintainer>
  <license>MIT</license>

  <buildtool_depend>ament_python</buildtool_depend>

  <!-- Runtime dependencies – all four sub-packages -->
  <exec_depend>cave_generator</exec_depend>
  <exec_depend>drone_bringup</exec_depend>
  <exec_depend>slam_pipeline</exec_depend>
  <exec_depend>exploration_planner</exec_depend>

  <!-- ROS 2 launch infrastructure -->
  <exec_depend>ros2launch</exec_depend>
  <exec_depend>launch</exec_depend>
  <exec_depend>launch_ros</exec_depend>

  <!-- ROS 2 runtime -->
  <exec_depend>rclpy</exec_depend>
  <exec_depend>std_msgs</exec_depend>
  <exec_depend>nav_msgs</exec_depend>
  <exec_depend>sensor_msgs</exec_depend>
  <exec_depend>visualization_msgs</exec_depend>

  <test_depend>ament_copyright</test_depend>
  <test_depend>ament_flake8</test_depend>
  <test_depend>ament_pep257</test_depend>
  <test_depend>python3-pytest</test_depend>

  <export>
    <build_type>ament_python</build_type>
  </export>
</package>
