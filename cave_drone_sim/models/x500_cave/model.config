<?xml version="1.0" encoding="UTF-8"?>
<!--
  x500_cave model.config
  ======================
  PX4 x500 quadrotor with cave exploration sensors:
    - 3D LiDAR (gpu_lidar, VLP-16 style)
    - Forward-facing depth camera
    - IMU (200 Hz)
-->
<model>
  <name>x500_cave</name>
  <version>1.0</version>
  <sdf version="1.9">model.sdf</sdf>
  <author>
    <name>cave_drone_sim</name>
    <email>thesis@cave-exploration.sim</email>
  </author>
  <description>
    PX4 x500 quadrotor augmented with 3D LiDAR, depth camera,
    and IMU for autonomous cave exploration.
  </description>
</model>
