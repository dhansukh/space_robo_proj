<?xml version="1.0"?>
<!--
  model.sdf  —  Gazebo Harmonic (SDF 1.9) model for cave_drone.
  Geometry, mass, and sensor parameters mirror cave_drone.urdf.xacro.

  Sensors:
    /drone/lidar/points         sensor_msgs/PointCloud2  (gpu_lidar, 10 Hz)
    /drone/depth_camera/depth   sensor_msgs/Image        (depth_camera, 15 Hz)
    /drone/depth_camera/image   sensor_msgs/Image        (depth_camera, 15 Hz)
    /drone/imu                  sensor_msgs/Imu          (imu, 200 Hz)
-->
<sdf version="1.9">
  <model name="cave_drone">
    <static>false</static>
    <self_collide>false</self_collide>

    <!-- ================================================================
         BASE LINK
         ================================================================ -->
    <link name="base_link">
      <pose>0 0 0 0 0 0</pose>

      <inertial>
        <mass>1.5</mass>
        <pose>0 0 0 0 0 0</pose>
        <!-- Solid box: Ixx = m(y²+z²)/12 -->
        <inertia>
          <ixx>0.032500</ixx>  <!-- 1.5*(0.5²+0.15²)/12 -->
          <ixy>0</ixy>
          <ixz>0</ixz>
          <iyy>0.032500</iyy>
          <iyz>0</iyz>
          <izz>0.062500</izz>  <!-- 1.5*(0.5²+0.5²)/12 -->
        </inertia>
      </inertial>

      <collision name="base_collision">
        <pose>0 0 0 0 0 0</pose>
        <geometry>
          <box><size>0.5 0.5 0.15</size></box>
        </geometry>
        <surface>
          <contact><ode/></contact>
          <friction><ode><mu>0.6</mu><mu2>0.6</mu2></ode></friction>
        </surface>
      </collision>

      <visual name="base_visual">
        <pose>0 0 0 0 0 0</pose>
        <geometry>
          <box><size>0.5 0.5 0.15</size></box>
        </geometry>
        <material>
          <ambient>0.25 0.25 0.25 1</ambient>
          <diffuse>0.25 0.25 0.25 1</diffuse>
          <specular>0.05 0.05 0.05 1</specular>
          <emissive>0 0 0 1</emissive>
        </material>
      </visual>
    </link>

    <!-- ================================================================
         ROTORS
         ================================================================ -->

    <!-- Rotor 0 — front-right, red -->
    <link name="rotor_0">
      <pose>0.22 0.22 0.086 0 0 0</pose>
      <inertial>
        <mass>0.05</mass>
        <inertia>
          <ixx>0.000072</ixx>
          <ixy>0</ixy><ixz>0</ixz>
          <iyy>0.000072</iyy>
          <iyz>0</iyz>
          <izz>0.000036</izz>
        </inertia>
      </inertial>
      <collision name="rotor_0_collision">
        <geometry><cylinder><radius>0.12</radius><length>0.01</length></cylinder></geometry>
      </collision>
      <visual name="rotor_0_visual">
        <geometry><cylinder><radius>0.12</radius><length>0.01</length></cylinder></geometry>
        <material>
          <ambient>0.8 0.0 0.0 1</ambient>
          <diffuse>0.8 0.0 0.0 1</diffuse>
        </material>
      </visual>
    </link>
    <joint name="rotor_0_joint" type="revolute">
      <parent>base_link</parent>
      <child>rotor_0</child>
      <pose>0 0 0 0 0 0</pose>
      <axis>
        <xyz>0 0 1</xyz>
        <dynamics><damping>0.001</damping><friction>0.001</friction></dynamics>
        <limit><lower>-1e16</lower><upper>1e16</upper></limit>
      </axis>
    </joint>

    <!-- Rotor 1 — rear-left, red -->
    <link name="rotor_1">
      <pose>-0.22 -0.22 0.086 0 0 0</pose>
      <inertial>
        <mass>0.05</mass>
        <inertia>
          <ixx>0.000072</ixx><ixy>0</ixy><ixz>0</ixz>
          <iyy>0.000072</iyy><iyz>0</iyz>
          <izz>0.000036</izz>
        </inertia>
      </inertial>
      <collision name="rotor_1_collision">
        <geometry><cylinder><radius>0.12</radius><length>0.01</length></cylinder></geometry>
      </collision>
      <visual name="rotor_1_visual">
        <geometry><cylinder><radius>0.12</radius><length>0.01</length></cylinder></geometry>
        <material>
          <ambient>0.8 0.0 0.0 1</ambient>
          <diffuse>0.8 0.0 0.0 1</diffuse>
        </material>
      </visual>
    </link>
    <joint name="rotor_1_joint" type="revolute">
      <parent>base_link</parent><child>rotor_1</child>
      <axis>
        <xyz>0 0 1</xyz>
        <dynamics><damping>0.001</damping><friction>0.001</friction></dynamics>
        <limit><lower>-1e16</lower><upper>1e16</upper></limit>
      </axis>
    </joint>

    <!-- Rotor 2 — front-left, black -->
    <link name="rotor_2">
      <pose>0.22 -0.22 0.086 0 0 0</pose>
      <inertial>
        <mass>0.05</mass>
        <inertia>
          <ixx>0.000072</ixx><ixy>0</ixy><ixz>0</ixz>
          <iyy>0.000072</iyy><iyz>0</iyz>
          <izz>0.000036</izz>
        </inertia>
      </inertial>
      <collision name="rotor_2_collision">
        <geometry><cylinder><radius>0.12</radius><length>0.01</length></cylinder></geometry>
      </collision>
      <visual name="rotor_2_visual">
        <geometry><cylinder><radius>0.12</radius><length>0.01</length></cylinder></geometry>
        <material>
          <ambient>0.05 0.05 0.05 1</ambient>
          <diffuse>0.05 0.05 0.05 1</diffuse>
        </material>
      </visual>
    </link>
    <joint name="rotor_2_joint" type="revolute">
      <parent>base_link</parent><child>rotor_2</child>
      <axis>
        <xyz>0 0 1</xyz>
        <dynamics><damping>0.001</damping><friction>0.001</friction></dynamics>
        <limit><lower>-1e16</lower><upper>1e16</upper></limit>
      </axis>
    </joint>

    <!-- Rotor 3 — rear-right, black -->
    <link name="rotor_3">
      <pose>-0.22 0.22 0.086 0 0 0</pose>
      <inertial>
        <mass>0.05</mass>
        <inertia>
          <ixx>0.000072</ixx><ixy>0</ixy><ixz>0</ixz>
          <iyy>0.000072</iyy><iyz>0</iyz>
          <izz>0.000036</izz>
        </inertia>
      </inertial>
      <collision name="rotor_3_collision">
        <geometry><cylinder><radius>0.12</radius><length>0.01</length></cylinder></geometry>
      </collision>
      <visual name="rotor_3_visual">
        <geometry><cylinder><radius>0.12</radius><length>0.01</length></cylinder></geometry>
        <material>
          <ambient>0.05 0.05 0.05 1</ambient>
          <diffuse>0.05 0.05 0.05 1</diffuse>
        </material>
      </visual>
    </link>
    <joint name="rotor_3_joint" type="revolute">
      <parent>base_link</parent><child>rotor_3</child>
      <axis>
        <xyz>0 0 1</xyz>
        <dynamics><damping>0.001</damping><friction>0.001</friction></dynamics>
        <limit><lower>-1e16</lower><upper>1e16</upper></limit>
      </axis>
    </joint>

    <!-- ================================================================
         LiDAR LINK  (Velodyne VLP-16 style, 3D)
         ================================================================ -->
    <link name="lidar_link">
      <pose>0 0 0.111 0 0 0</pose>  <!-- body_z/2 + 0.036 = 0.075 + 0.036 -->
      <inertial>
        <mass>0.83</mass>
        <inertia>
          <ixx>0.001226</ixx><ixy>0</ixy><ixz>0</ixz>
          <iyy>0.001226</iyy><iyz>0</iyz>
          <izz>0.001108</izz>
        </inertia>
      </inertial>
      <collision name="lidar_collision">
        <geometry><cylinder><radius>0.0516</radius><length>0.0717</length></cylinder></geometry>
      </collision>
      <visual name="lidar_visual">
        <geometry><cylinder><radius>0.0516</radius><length>0.0717</length></cylinder></geometry>
        <material>
          <ambient>0.4 0.4 0.4 1</ambient>
          <diffuse>0.4 0.4 0.4 1</diffuse>
        </material>
      </visual>

      <!-- gpu_lidar sensor — Gazebo Harmonic -->
      <sensor name="lidar" type="gpu_lidar">
        <update_rate>10</update_rate>
        <topic>/drone/lidar/points</topic>
        <gz_frame_id>lidar_link</gz_frame_id>
        <lidar>
          <scan>
            <horizontal>
              <samples>1800</samples>
              <resolution>1</resolution>
              <min_angle>-3.14159265</min_angle>
              <max_angle> 3.14159265</max_angle>
            </horizontal>
            <vertical>
              <samples>16</samples>
              <resolution>1</resolution>
              <min_angle>-0.26179939</min_angle>
              <max_angle> 0.26179939</max_angle>
            </vertical>
          </scan>
          <range>
            <min>0.1</min>
            <max>100.0</max>
            <resolution>0.001</resolution>
          </range>
          <noise>
            <type>gaussian</type>
            <mean>0.0</mean>
            <stddev>0.01</stddev>
          </noise>
        </lidar>
        <always_on>true</always_on>
        <visualize>false</visualize>
      </sensor>
    </link>

    <joint name="lidar_joint" type="fixed">
      <parent>base_link</parent>
      <child>lidar_link</child>
    </joint>

    <!-- ================================================================
         DEPTH CAMERA LINK
         ================================================================ -->
    <link name="depth_camera_link">
      <!-- 0.15 m forward, -0.02 m below centre, -10° pitch -->
      <pose>0.15 0 -0.02 0 -0.1745329 0</pose>
      <inertial>
        <mass>0.07</mass>
        <inertia>
          <ixx>0.000004</ixx><ixy>0</ixy><ixz>0</ixz>
          <iyy>0.000004</iyy><iyz>0</iyz>
          <izz>0.000005</izz>
        </inertia>
      </inertial>
      <collision name="depth_cam_collision">
        <geometry><box><size>0.04 0.09 0.025</size></box></geometry>
      </collision>
      <visual name="depth_cam_visual">
        <geometry><box><size>0.04 0.09 0.025</size></box></geometry>
        <material>
          <ambient>0.1 0.1 0.1 1</ambient>
          <diffuse>0.1 0.1 0.1 1</diffuse>
        </material>
      </visual>

      <!-- depth_camera sensor — Gazebo Harmonic -->
      <sensor name="depth_camera" type="depth_camera">
        <update_rate>15</update_rate>
        <topic>/drone/depth_camera</topic>
        <gz_frame_id>depth_camera_link</gz_frame_id>
        <camera>
          <horizontal_fov>1.5184</horizontal_fov>
          <image>
            <width>640</width>
            <height>480</height>
            <format>R_FLOAT32</format>
          </image>
          <clip>
            <near>0.1</near>
            <far>10.0</far>
          </clip>
          <noise>
            <type>gaussian</type>
            <mean>0.0</mean>
            <stddev>0.01</stddev>
          </noise>
        </camera>
        <always_on>true</always_on>
        <visualize>false</visualize>
      </sensor>
    </link>

    <joint name="depth_camera_joint" type="fixed">
      <parent>base_link</parent>
      <child>depth_camera_link</child>
    </joint>

    <!-- ================================================================
         IMU LINK
         ================================================================ -->
    <link name="imu_link">
      <pose>0 0 0 0 0 0</pose>
      <inertial>
        <mass>0.015</mass>
        <inertia>
          <ixx>0.0000005</ixx><ixy>0</ixy><ixz>0</ixz>
          <iyy>0.0000005</iyy><iyz>0</iyz>
          <izz>0.0000005</izz>
        </inertia>
      </inertial>
      <collision name="imu_collision">
        <geometry><box><size>0.02 0.02 0.01</size></box></geometry>
      </collision>
      <visual name="imu_visual">
        <geometry><box><size>0.02 0.02 0.01</size></box></geometry>
        <material>
          <ambient>0.0 0.8 0.0 1</ambient>
          <diffuse>0.0 0.8 0.0 1</diffuse>
        </material>
      </visual>

      <!-- imu sensor — Gazebo Harmonic -->
      <sensor name="imu" type="imu">
        <update_rate>200</update_rate>
        <topic>/drone/imu</topic>
        <gz_frame_id>imu_link</gz_frame_id>
        <imu>
          <angular_velocity>
            <x><noise type="gaussian"><mean>0</mean><stddev>0.01</stddev><bias_mean>0</bias_mean><bias_stddev>0.001</bias_stddev></noise></x>
            <y><noise type="gaussian"><mean>0</mean><stddev>0.01</stddev><bias_mean>0</bias_mean><bias_stddev>0.001</bias_stddev></noise></y>
            <z><noise type="gaussian"><mean>0</mean><stddev>0.01</stddev><bias_mean>0</bias_mean><bias_stddev>0.001</bias_stddev></noise></z>
          </angular_velocity>
          <linear_acceleration>
            <x><noise type="gaussian"><mean>0</mean><stddev>0.1</stddev><bias_mean>0</bias_mean><bias_stddev>0.01</bias_stddev></noise></x>
            <y><noise type="gaussian"><mean>0</mean><stddev>0.1</stddev><bias_mean>0</bias_mean><bias_stddev>0.01</bias_stddev></noise></y>
            <z><noise type="gaussian"><mean>0</mean><stddev>0.1</stddev><bias_mean>0</bias_mean><bias_stddev>0.01</bias_stddev></noise></z>
          </linear_acceleration>
        </imu>
        <always_on>true</always_on>
      </sensor>
    </link>

    <joint name="imu_joint" type="fixed">
      <parent>base_link</parent>
      <child>imu_link</child>
    </joint>

    <!-- ================================================================
         PLUGINS
         ================================================================ -->
    <plugin
      filename="gz-sim-apply-link-wrench-system"
      name="gz::sim::systems::ApplyLinkWrench">
    </plugin>

  </model>
</sdf>
