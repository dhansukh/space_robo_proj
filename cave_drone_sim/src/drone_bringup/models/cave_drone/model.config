<?xml version="1.0"?>
<!--
  model.config
  Gazebo Fuel / local model description for the cave_drone.
  Compatible with Gazebo Harmonic (gz-sim 8.x).
-->
<model>
  <name>cave_drone</name>
  <version>1.0</version>
  <sdf version="1.9">model.sdf</sdf>

  <author>
    <name>drone_bringup</name>
    <email>thesis@cave-exploration.sim</email>
  </author>

  <description>
    Quadrotor drone for autonomous cave exploration simulation.
    Equipped with a 3D LiDAR (Velodyne VLP-16 style), a forward-facing
    depth camera, and an IMU.  Designed for use with Gazebo Harmonic
    and the ROS 2 drone_bringup package.
  </description>

  <depend>
    <uri>model://ground_plane</uri>
  </depend>
</model>
